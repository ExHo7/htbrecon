# HTBRecon configuration — copy to `.env` and fill in.
# Only the LLM features (AI analysis + vulnx tech normalisation / version
# filtering) read these. Without any provider, those features are skipped.

# Which LLM backend to use: auto | anthropic | ollama
#   auto -> anthropic if ANTHROPIC_API_KEY is set, otherwise ollama
HTBRECON_LLM_PROVIDER=auto

# --- Anthropic (cloud) ---
# Required when the provider resolves to "anthropic".
ANTHROPIC_API_KEY=
# Optional model overrides (defaults shown). "small" = fast tasks (vulnx tech
# normalisation / version filtering), "large" = the final attack-vector analysis.
HTBRECON_ANTHROPIC_MODEL_SMALL=claude-haiku-4-5-20251001
HTBRECON_ANTHROPIC_MODEL_LARGE=claude-sonnet-4-20250514

# --- Ollama (local) ---
# Base URL of the Ollama server.
OLLAMA_HOST=http://localhost:11434
# Model to use (required when the provider resolves to "ollama").
# Pull it first, e.g.  ollama pull qwen2.5:7b
# Example with a model already present on this host:
HTBRECON_OLLAMA_MODEL=metatron-qwen:latest
# Request timeout in seconds. Local generation is slow — the final analysis on a
# 7-9B model can take minutes. Raise if you see "ollama completion failed: ReadTimeout".
HTBRECON_OLLAMA_TIMEOUT=600

# --- Tool path overrides (optional) ---
# Force a specific binary/command for a tool when auto-resolution (PATH, then
# known fallbacks) picks the wrong one. Name = HTBRECON_TOOL_<TOOL> (upper-case,
# dashes -> underscores). Same keys can go in ~/.config/htbrecon/config.toml
# under [tools]. Examples:
# HTBRECON_TOOL_WHATWEB=/opt/tools/WhatWeb/whatweb
# HTBRECON_TOOL_ENUM4LINUX_NG=/opt/tools/enum4linux-ng/enum4linux-ng.py

# --- Wordlist overrides (optional) ---
# Point a wordlist kind at a custom file when seclists/dirb aren't in the
# standard locations. Kinds: SUBDOMAINS | DIRECTORIES | USERNAMES | API.
# Same keys can go in config.toml under [wordlists]. Examples:
# HTBRECON_WORDLIST_DIRECTORIES=/home/me/wordlists/common.txt
# HTBRECON_WORDLIST_SUBDOMAINS=/home/me/wordlists/subdomains.txt
