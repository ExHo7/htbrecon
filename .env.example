# HTBRecon configuration — copy to `.env` and fill in.
# Only the LLM features (AI analysis + vulnx tech normalisation / version
# filtering) read these. Without any provider, those features are skipped.

# Which LLM backend to use: auto | anthropic | ollama
#   auto -> anthropic if ANTHROPIC_API_KEY is set, otherwise ollama
HTBRECON_LLM_PROVIDER=auto

# --- Anthropic (cloud) ---
# Required when the provider resolves to "anthropic".
ANTHROPIC_API_KEY=
# Optional model overrides (defaults shown). "small" = fast tasks (vulnx tech
# normalisation / version filtering), "large" = the final attack-vector analysis.
HTBRECON_ANTHROPIC_MODEL_SMALL=claude-haiku-4-5-20251001
HTBRECON_ANTHROPIC_MODEL_LARGE=claude-sonnet-4-20250514

# --- Ollama (local) ---
# Base URL of the Ollama server.
OLLAMA_HOST=http://localhost:11434
# Model to use (required when the provider resolves to "ollama").
# Pull it first, e.g.  ollama pull qwen2.5:7b
# Example with a model already present on this host:
HTBRECON_OLLAMA_MODEL=metatron-qwen:latest
